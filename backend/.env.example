NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_NAME=restaurant_management
DB_USER=root
DB_PASSWORD=root
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Image Storage Driver: "cloudinary" (default for local dev) or "s3" (for AWS production)
IMAGE_STORAGE=cloudinary

# Cloudinary Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS S3 Credentials (AWS_S3_BUCKET required when IMAGE_STORAGE=s3; access keys optional if using IAM Role on EC2)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# AWS_S3_ENDPOINT=         # Optional: Custom endpoint (e.g. http://localhost:9000 for MinIO/LocalStack)
# AWS_S3_FORCE_PATH_STYLE= # Optional: set true for MinIO/LocalStack
# AWS_S3_CUSTOM_URL=       # Optional: CDN or CloudFront URL base (e.g. https://cdn.myrestaurant.com)

